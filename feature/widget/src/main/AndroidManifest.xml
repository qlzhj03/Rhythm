<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Rhythm Music Widget (Modern Glance with Material 3) -->
        <receiver
            android:name=".infrastructure.widget.glance.RhythmWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name_glance"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_glance" />
        </receiver>

        <!-- Lyric Widget Provider (Glance-based) -->
        <receiver
            android:name=".infrastructure.widget.glance.RhythmLyricsWidgetReceiver"
            android:exported="true"
            android:label="Rhythm Lyrics"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lyric_widget" />
        </receiver>

        <!-- Rhythm Cookie Widget -->
        <receiver
            android:name=".infrastructure.widget.glance.RhythmCookieWidgetReceiver"
            android:exported="true"
            android:label="Rhythm Cookie"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rhythm_cookie_widget_info" />
        </receiver>

        <!-- Rhythm Stats Widget -->
        <receiver
            android:name=".infrastructure.widget.glance.RhythmStatsWidgetReceiver"
            android:exported="true"
            android:label="Rhythm Stats"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rhythm_stats_widget_info" />
        </receiver>

        <!-- Rhythm Quick Settings Tile Service -->
        <service
            android:name=".infrastructure.service.RhythmTileService"
            android:label="@string/app_name"
            android:icon="@drawable/ic_notification"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
